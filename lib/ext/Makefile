fetch-blockly:
	wget https://github.com/google/blockly/releases/download/blockly-v13.4.0/blockly-13.4.0.tgz
	tar xf blockly-13.4.0.tgz && mv package blockly-13.4.0

fetch-shadow-block-converter:
	wget https://cdn.jsdelivr.net/npm/@blockly/shadow-block-converter@13.4.0/dist/index.js
	mv index.js shadow-block-converter-13.4.0/dist/index.js

fetch-toolbox-search:
	wget https://cdn.jsdelivr.net/npm/@blockly/toolbox-search@13.4.0/dist/index.js
	mv index.js toolbox-search-13.4.0/dist/index.js
